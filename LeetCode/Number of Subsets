class Solution {
public:
    int f(int ind, int sum, vector<int>& nums, vector<vector<int>>& dp){
        if(ind == 0){
            if(sum == 0 && nums[0] == 0) return 2;
            if(sum == 0 || sum == nums[0]) return 1;
            return 0; 
        }
        if(dp[ind][sum] != -1) return dp[ind][sum];
        int notTake = f(ind-1,sum,num,dp);
        int take = 0;
        if(nums[ind] <= sum) take = f(ind-1,sum-nums[ind],nums,dp);
        return dp[ind][sum] = take + notTake;
    }
    int countPartitions(vector<int>& nums, int tar){
        int n = nums.size();
        vector<vector<int>> dp(n,vector<int>(tar+1,-1));
        return f(n-1,tar,nums,dp);
    }
};
